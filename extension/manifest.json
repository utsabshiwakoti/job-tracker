{
  "manifest_version": 3,
  "name": "Job Tracker Capture",
  "version": "1.0.0",
  "description": "Save job postings and automatically log applications to your Job Tracker.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Job Tracker"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["parsers.js", "common.js", "linkedin.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.indeed.com/*"],
      "js": ["parsers.js", "common.js", "indeed.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
